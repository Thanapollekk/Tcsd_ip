<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ส่งรูปภาพหาเพื่อน - PIZZA COMMANDO</title>
    <!-- โหลด LIFF SDK เจี๊ยก เจี๊ยก -->
    <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 50px; background-color: #f4f4f4;}
        button { padding: 15px 30px; font-size: 18px; background-color: #06C755; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold;}
        button:hover { background-color: #05A546; }
    </style>
</head>
<body>

    <h1>ส่งรูปภาพเมนูพิซซ่าให้เพื่อน เจี๊ยก เจี๊ยก</h1>
    <p>กดปุ่มด้านล่างเพื่อเลือกเพื่อนใน LINE และส่งรูปภาพออกไป</p>
    
    <!-- ปุ่มเลือกเพื่อนเพื่อส่งรูป เจี๊ยก เจี๊ยก -->
    <button id="shareImageButton" style="display: none;">เลือกเพื่อนเพื่อส่งรูปภาพ</button>

    <script>
        // ใส่ LIFF ID ของนายที่นี่ เจี๊ยก เจี๊ยก
        const myLiffId = "ใส่_LIFF_ID_ของคุณที่นี่";

        async function initializeLiff() {
            try {
                await liff.init({ liffId: myLiffId });
                
                if (!liff.isLoggedIn()) {
                    liff.login();
                } else {
                    // ล็อกอินแล้วแสดงปุ่ม เจี๊ยก เจี๊ยก
                    document.getElementById("shareImageButton").style.display = "inline-block";
                }
            } catch (err) {
                console.error("ระบบ LIFF เกิดข้อผิดพลาด ", err);
            }
        }

        // ฟังก์ชันเปิดหน้าต่างเลือกเพื่อนเพื่อส่งรูป เจี๊ยก เจี๊ยก
        async function sendImageToUser() {
            // เช็คว่าอุปกรณ์รองรับ Share Target Picker ไหม เจี๊ยก เจี๊ยก
            if (liff.isApiAvailable('shareTargetPicker')) {
                try {
                    const result = await liff.shareTargetPicker([
                        {
                            type: "image",
                            // สำคัญ: ลิงก์รูปภาพต้องเป็น HTTPS ที่เข้าถึงได้จากอินเทอร์เน็ต
                            originalContentUrl: "https://example.com/images/pizza-menu.jpg", 
                            previewImageUrl: "https://example.com/images/pizza-menu-preview.jpg"
                        }
                    ]);
                    
                    if (result) {
                        alert("ส่งรูปภาพให้เพื่อนสำเร็จแล้ว เจี๊ยก เจี๊ยก!");
                        liff.closeWindow(); // ปิดหน้าต่างหลังส่งเสร็จ
                    } else {
                        console.log("ผู้ใช้กดยกเลิกการส่ง เจี๊ยก เจี๊ยก");
                    }
                } catch (error) {
                    console.error("เกิดข้อผิดพลาดในการแชร์รูป เจี๊ยก เจี๊ยก", error);
                    alert("ส่งรูปไม่สำเร็จ: " + error.message);
                }
            } else {
                alert("อุปกรณ์นี้ไม่รองรับฟังก์ชัน Share Target Picker เจี๊ยก เจี๊ยก");
            }
        }

        // ผูกปุ่มเข้ากับฟังก์ชัน
        document.getElementById("shareImageButton").addEventListener("click", sendImageToUser);

        // เริ่มต้นทำงาน LIFF
        initializeLiff();
    </script>
</body>
</html>
